.spot-list {
  padding: 0 32rpx 32rpx;
}

.spot-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(17, 24, 39, 0.04);
}

.spot-icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.spot-emoji {
  font-size: 56rpx;
  line-height: 1;
}

.spot-info {
  flex: 1;
  margin: 0 20rpx;
  min-width: 0;
}

.spot-head {
  display: flex;
  align-items: center;
}

.spot-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #111111;
}

.spot-distance {
  display: flex;
  align-items: center;
  margin-left: 14rpx;
  font-size: 22rpx;
  color: #999999;
}

.spot-pin {
  width: 12rpx;
  height: 12rpx;
  background: #e5484d;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  margin-right: 6rpx;
}

.spot-desc {
  display: block;
  font-size: 24rpx;
  color: #8a8f99;
  margin-top: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.audio-tag {
  display: inline-flex;
  align-items: center;
  margin-top: 14rpx;
  background: #e7f8f0;
  color: #0eb877;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
}

.audio-play {
  font-size: 18rpx;
  margin-right: 8rpx;
}

.nav-btn {
  background: #0eb877;
  color: #ffffff;
  font-size: 26rpx;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}
