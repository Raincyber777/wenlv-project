.orders-card {
  position: relative;
  margin: -60rpx 32rpx 0;
  border-radius: 24rpx;
  padding: 30rpx 24rpx 36rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(17, 24, 39, 0.04);
}

.orders-title {
  display: block;
  padding: 0 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.orders-grid {
  display: flex;
  justify-content: space-around;
  margin-top: 30rpx;
}

.order-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.order-item-hover {
  opacity: 0.7;
}

.order-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.order-emoji {
  font-size: 44rpx;
  line-height: 1;
}

.order-name {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #333333;
}
