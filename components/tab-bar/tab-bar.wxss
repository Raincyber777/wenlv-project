.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #eceff1;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 12rpx;
  position: relative;
}

.tab-indicator {
  position: absolute;
  top: 0;
  width: 56rpx;
  height: 6rpx;
  border-radius: 0 0 6rpx 6rpx;
  background: transparent;
}

.tab-indicator.show {
  background: #0eb877;
}

.icon-wrap {
  position: relative;
}

.tab-icon {
  font-size: 44rpx;
  line-height: 1;
  filter: grayscale(1);
  opacity: 0.55;
}

.tab-item.active .tab-icon {
  filter: none;
  opacity: 1;
}

.tab-badge {
  position: absolute;
  top: -10rpx;
  right: -18rpx;
  min-width: 30rpx;
  height: 30rpx;
  background: #f53f3f;
  border-radius: 999rpx;
  font-size: 18rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  box-sizing: border-box;
}

.tab-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a8f99;
}

.tab-item.active .tab-label {
  color: #0eb877;
  font-weight: 600;
}
